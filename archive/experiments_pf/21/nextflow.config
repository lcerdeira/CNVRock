params {
    bin_length              = 1000
    minimum_mapping_quality = 40

    // TODO: set these to your downloaded HS11286 reference files.
    // Download: ncbi-datasets download genome accession GCF_000240185.1 \
    //             --include genome --filename HS11286.zip
    reference_fasta = "/path/to/HS11286.fasta"       // NC_016845.1
    reference_fai   = "/path/to/HS11286.fasta.fai"
    reference_dict  = "/path/to/HS11286.dict"
}

profiles {
    local {
        docker {
            enabled = false
        }
        process {
            cache     = "lenient"
            container = "broadinstitute/gatk:4.6.2.0"
            executor  = "local"
        }
        executor {
            name      = "local"
            cpus      = 8
            memory    = "16 GB"
        }
    }

    // LSHTM HPC (SLURM) — run: nextflow run main.nf -profile lshtm_slurm -resume
    // TODO: confirm partition names with `sinfo` on loginhpc before running.
    // TODO: set reference_fasta/fai/dict params above to your HPC scratch paths.
    lshtm_slurm {
        docker {
            enabled = false
        }
        singularity {
            enabled    = true
            autoMounts = true
            // TODO: add any bind mounts your scratch/project paths need, e.g.:
            // runOptions = "--bind /scratch,/project"
        }
        process {
            cache     = "lenient"
            container = "broadinstitute/gatk:4.6.2.0"
            queue     = "normal"
        }
        executor {
            name            = "slurm"
            queueSize       = 500
            jobName         = { "kpsc-cnv - $task.name - $task.hash" }
            pollInterval    = "30 sec"
            submitRateLimit = "10 sec"
        }
    }

    sanger_lsf {
        docker {
            enabled = false
        }
        singularity {
            enabled    = true
            autoMounts = true
            runOptions = "--bind /lustre,/software,/nfs"
        }
        process {
            cache          = "lenient"
            container      = "broadinstitute/gatk:4.6.2.0"
            clusterOptions = "-G team342"
        }
        executor {
            name            = "lsf"
            perJobMemLimit  = true
            queueSize       = 4000
            jobName         = { "kpsc-cnv - $task.name - $task.hash" }
            pollInterval    = "15 sec"
            dumpInterval    = "30min"
            submitRateLimit = "5 sec"
        }
    }
}
